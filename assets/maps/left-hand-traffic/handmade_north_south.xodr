<?xml version="1.0" encoding="UTF-8"?>
<!-- Left-hand traffic two-way corridor along +Y (OpenDRIVE hdg = pi/2).
     Same lane layout as handmade_two_way, rotated so centerlines are not east-west.
     +s is north; LHT positive IDs travel north, negative IDs travel south. -->
<OpenDRIVE>
  <header revMajor="1" revMinor="6" name="lht_north_south" version="1.0" date="2026-10-14"/>
  <road name="LHT North South" length="20.0" id="4" junction="-1" rule="LHT">
    <type s="0" type="town">
      <speed max="50" unit="km/h"/>
    </type>
    <planView>
      <geometry s="0" x="0" y="0" hdg="1.5707963267948966" length="20.0">
        <line/>
      </geometry>
    </planView>
    <lanes>
      <laneOffset s="0" a="0" b="0" c="0" d="0"/>
      <laneSection s="0">
        <left>
          <lane id="2" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0"/>
          </lane>
          <lane id="1" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0"/>
          </lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0"/>
          </lane>
          <lane id="-2" type="driving" level="false">
            <width sOffset="0" a="3.5" b="0" c="0" d="0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
